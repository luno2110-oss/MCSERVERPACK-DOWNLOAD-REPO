{
  "problemMatcher": [
    {
      "owner": "javac",
      "severity": "error",
      "pattern": [
        {
          "regexp": "^\\[ERROR\\] (.+\\.java):\\[(\\d+),(\\d+)\\] (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      ]
    }
  ]
}
